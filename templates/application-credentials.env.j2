# Credenciais em texto plano do usuário da aplicação. Não versionar este arquivo.
# PGHOST deve ser um DNS/IP acessível pela aplicação externa.
PGHOST={{ pg_application_host | quote }}
PGPORT={{ pg_port | string | quote }}
PGDATABASE={{ pg_database | quote }}
PGUSER={{ pg_owner | quote }}
PGPASSWORD={{ (pg_credentials.content | b64decode | from_json).password | quote }}
